<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textColor="#1F2937"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- USER AVATAR & NAME HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivAjustesUserAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_card_cuadrado"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvAjustesUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Cuenta"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- OPTIONS CARD GROUP 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cuadrado"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnAjustesVerPerfil"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="👤  Ver mi perfil"
                android:textColor="#1F2937"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <Button
                android:id="@+id/btnAjustesEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="✏️  Editar perfil"
                android:textColor="#1F2937"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <Button
                android:id="@+id/btnAjustesMisiones"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="🎯  Misiones y Retos"
                android:textColor="#1F2937"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <Button
                android:id="@+id/btnAjustesMonetizacion"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="💳  Monetización QvaPay"
                android:textColor="#1F2937"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- OPTIONS CARD GROUP 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cuadrado"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnAjustesConfig"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="⚙️  Configuraciones"
                android:textColor="#1F2937"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <Button
                android:id="@+id/btnAjustesLinkAI"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="🤖  Link AI"
                android:textColor="#5B21B6"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LOGOUT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cuadrado"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnAjustesCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="🚪  Cerrar sesión"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
