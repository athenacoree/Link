<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tocaste dos veces a esta persona — ¿qué te pareció? (opcional)"
        android:textColor="#111827"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <LinearLayout
            android:id="@+id/llReactionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Reaction buttons will be dynamically added or mapped in Kotlin code -->
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCerrarReaccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_secondary"
        android:text="Cerrar (Guardado privado)"
        android:textColor="#374151"
        android:textSize="12sp" />
</LinearLayout>
