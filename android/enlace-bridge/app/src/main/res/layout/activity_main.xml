<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <!-- TOP PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBarTop"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentTop="true"
        android:max="100"
        android:visibility="gone" />

    <!-- MAIN NATIVE FEED CONTAINER -->
    <LinearLayout
        android:id="@+id/containerNativeFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/nativeBottomBar"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="visible">

        <!-- HORIZONTAL STORIES BAR -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStoriesBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp" />

        <!-- SEARCH BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_search_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etSearchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Buscar por nombre, municipio o profesión…"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"
                android:textSize="12sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <!-- FILTERS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Spinner
                android:id="@+id/spGenderFilter"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_search_input" />

            <Spinner
                android:id="@+id/spOnlineFilter"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_search_input" />
        </LinearLayout>

        <!-- FEED RECYCLER VIEW & EMPTY VIEW -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNativeFeed"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/pbFeedLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFeedEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No hay nadie que mostrar por ahora."
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- WEBVIEW CONTAINER (When switching to other tabs) -->
    <WebView
        android:id="@+id/mainWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/nativeBottomBar"
        android:visibility="gone" />

    <!-- NATIVE BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/nativeBottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- TAB 1: Inicio / Feed -->
        <LinearLayout
            android:id="@+id/tabFeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/lblFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="#5B21B6"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TAB 2: Contactos -->
        <FrameLayout
            android:id="@+id/tabContactos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/iconContactos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/lblContactos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contactos"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/badgeContactos"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_tab_badge"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- TAB 3: Mensajes -->
        <FrameLayout
            android:id="@+id/tabMensajes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/iconMensajes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/lblMensajes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensajes"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/badgeMensajes"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_tab_badge"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- TAB 4: Link Video -->
        <LinearLayout
            android:id="@+id/tabLinkVideo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconLinkVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/lblLinkVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Link Video"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- TAB 5: Ajustes -->
        <LinearLayout
            android:id="@+id/tabAjustes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconAjustes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/lblAjustes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
