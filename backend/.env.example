# ============================================================
#  ENLACE — variables de entorno
#  Copia este archivo como ".env" en local, o cárgalas como
#  "Environment Variables" en el panel de Render (no subas .env real).
# ============================================================

# Puerto del servidor (Render lo inyecta solo, no lo toques en producción)
PORT=10000

# --- PostgreSQL (Render la crea automáticamente si usas render.yaml) ---
# Render inyecta esta variable sola cuando conectas la base de datos al
# servicio web dentro del Blueprint (fromDatabase). En local, pon aquí
# la cadena de conexión de tu Postgres de pruebas.
DATABASE_URL=postgresql://usuario:password@host:5432/enlace

# --- MongoDB Atlas (mensajes de chat) ---
# Crea un cluster gratuito M0 en https://cloud.mongodb.com, un usuario de
# base de datos, y copia aquí la cadena de conexión (con el nombre de la
# base de datos al final, ej: /enlace)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/enlace?retryWrites=true&w=majority

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=30d

# --- CORS: dominio(s) desde donde se permite el acceso al API ---
# En producción, si sirves el frontend desde el mismo servicio Express,
# puedes dejar "*" o poner tu dominio de Render.
CORS_ORIGIN=*

# --- Limpieza automática de estados (stories) vencidos, en minutos ---
STORY_CLEANUP_INTERVAL_MIN=15

# --- Administradores ---
# Correos (separados por coma) que se vuelven administradores automáticamente
# al iniciar sesión o registrarse. Solo estos correos pueden acceder al panel
# de administrador (verificar cuentas, banear, borrar/editar publicaciones,
# revisar reportes). Ejemplo: ADMIN_EMAILS=tucorreo@gmail.com,otro@correo.com
ADMIN_EMAILS=

# --- Google Gemini API ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=120000

# --- QvaPay Monetización ---
QVAPAY_APP_ID=
QVAPAY_APP_SECRET=
QVAPAY_WEBHOOK_URL=https://tu-dominio.onrender.com/api/monetizacion/webhook/qvapay

# --- Editor de Imágenes Externo (Render) ---
IMAGE_EDITOR_BASE_URL=
IMAGE_EDITOR_API_KEY=
